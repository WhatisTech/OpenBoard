{
  /*
   * OpenBoard - HarmonyOS Input Method Application
   * Build Profile Configuration
   */

  "app": {
    /*
     * ========================================
     * SIGNING CONFIGURATION
     * ========================================
     * IMPORTANT: You MUST configure signing before building!
     *
     * Option 1 - Automatic Signing (Recommended for Development):
     *   1. Open project in DevEco Studio
     *   2. Go to: File → Project Structure → Signing Configs
     *   3. Enable "Automatically generate signature"
     *   4. Click OK
     *
     * Option 2 - Manual Signing:
     *   1. Generate your own certificates and provisioning profile
     *   2. Fill in the material fields below with your paths
     *   3. Never commit your actual signing credentials to git!
     *
     * Note: The empty configuration below is intentional for version control.
     *       DevEco Studio will populate this when you configure signing.
     */
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "",
          // Path to your .cer certificate file
          "keyAlias": "",
          // Your key alias (e.g., "debugKey")
          "keyPassword": "",
          // Your encrypted key password
          "profile": "",
          // Path to your .p7b provisioning profile
          "signAlg": "SHA256withECDSA",
          "storeFile": "",
          // Path to your .p12 keystore file
          "storePassword": ""
          // Your encrypted store password
        }
      }
    ],
    /*
     * ========================================
     * PRODUCT CONFIGURATION
     * ========================================
     * Defines build products (typically "default" for standard builds)
     */
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // SDK Version: HarmonyOS NEXT
        "compatibleSdkVersion": "5.1.0(18)",
        "targetSdkVersion": "5.1.0(18)",
        // Runtime: Full HarmonyOS (not OpenHarmony)
        "runtimeOS": "HarmonyOS"
      }
    ]
  },
  /*
   * ========================================
   * MODULE CONFIGURATION
   * ========================================
   * Single-module architecture: All code consolidated in entry module
   */
  "modules": [
    {
      "name": "entry",
      "srcPath": "./products/default",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}